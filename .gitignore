# Built by Gradle
.gradle/
build/
app/build/

# The tunnel core is downloaded and hash-verified at build time (see
# app/build.gradle.kts) rather than committed: it is ~62 MB and would otherwise
# live in every clone of this repository forever.
app/libs/*.aar
app/libs/*.aar.part

# Local configuration — never commit these
local.properties
keystore.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
.navigation/

# macOS
.DS_Store

# Captures / profiling
captures/
*.hprof
*.trace

# NDK
.externalNativeBuild/
.cxx/

# Signing artefacts
*.apk
*.aab
*.ap_
*.dex
output.json

# Logs and temporary files
*.log
*.tmp
