<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Subscription URLs carry tokens; keep them off Google's servers. -->
        <exclude domain="file" path="datastore/darkvvpn_subscriptions.preferences_pb" />
        <exclude domain="file" path="datastore/darkvvpn_settings.preferences_pb" />
        <exclude domain="sharedpref" path="darkvvpn_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/darkvvpn_subscriptions.preferences_pb" />
        <exclude domain="file" path="datastore/darkvvpn_settings.preferences_pb" />
        <exclude domain="sharedpref" path="darkvvpn_secure.xml" />
    </device-transfer>
</data-extraction-rules>
