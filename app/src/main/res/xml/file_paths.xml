<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider share roots.

    The APK downloaded for an in-app update lives strictly in the app's private
    updates directory (cacheDir/updates). Nothing else in the app's storage is
    shared, so a bug elsewhere cannot turn this provider into a way to read
    other cache contents or data directories.
-->
<paths>
    <!-- cacheDir/updates/update-<tag>.apk -->
    <cache-path
        name="update_apks"
        path="updates" />
</paths>
