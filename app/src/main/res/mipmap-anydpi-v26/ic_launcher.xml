<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon for API 26–32. No `monochrome`: that attribute arrives in
    Android 13 and the -v33 variant carries it.

    NOTE: this is an <adaptive-icon>, which Compose cannot rasterize. Never pass
    R.mipmap.ic_launcher to painterResource — use a bitmap drawable instead
    (see drawable-nodpi/splash_logo.png).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/dark_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
